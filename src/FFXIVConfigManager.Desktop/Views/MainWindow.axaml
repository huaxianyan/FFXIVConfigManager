<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFXIVConfigManager.Desktop.ViewModels"
        xmlns:l10n="using:FFXIVConfigManager.Desktop.Localization"
        x:Class="FFXIVConfigManager.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Icon="/Assets/app.ico"
        Title="{l10n:Tr AppTitle}">

    <Window.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="Background" Value="#0A808080" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#16808080" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#285B8DEF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto">
        <Border Grid.RowSpan="2" Background="#0E808080"
                BorderBrush="#40808080" BorderThickness="0,0,1,0">
            <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Margin="8,10,8,22" Spacing="4">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{l10n:Tr AppShortTitle}" />
                    <TextBlock FontSize="12" Opacity="0.6" Text="{l10n:Tr AppTagline}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Classes.nav="True" Classes.active="{Binding IsDashboardPage}"
                            Command="{Binding ShowDashboardCommand}" Content="{l10n:Tr Dashboard}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsCharactersPage}"
                            Command="{Binding ShowCharactersCommand}" Content="{l10n:Tr Characters}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsBackupsPage}"
                            Command="{Binding ShowBackupsCommand}" Content="{l10n:Tr Backups}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsMigrationPage}"
                            Command="{Binding ShowMigrationCommand}" Content="{l10n:Tr Migration}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsSettingsPage}"
                            Command="{Binding ShowSettingsCommand}" Content="{l10n:Tr Settings}" />
                </StackPanel>

                <Border Grid.Row="3" Classes="card" Padding="12">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{l10n:Tr CurrentStatus}" />
                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                   MaxLines="4" Text="{Binding StatusMessage}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Padding="28,20" BorderBrush="#40808080" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
                        <TextBlock Opacity="0.65" Text="{Binding PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <ProgressBar Width="90" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                        <Button Command="{Binding RefreshCommand}" Content="{l10n:Tr Refresh}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 概览 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsDashboardPage}">
                <StackPanel Margin="28" Spacing="20">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="{l10n:Tr ProfileSource}" />
                                <TextBlock Classes="stat-value" Text="{Binding Profiles.Count}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="{l10n:Tr DiscoveredCharacters}" />
                                <TextBlock Classes="stat-value" Text="{Binding Characters.Count}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="{l10n:Tr ValidBackups}" />
                                <TextBlock Classes="stat-value" Text="{Binding HealthyBackupCount}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="{l10n:Tr CorruptedBackups}" />
                                <TextBlock Classes="stat-value" Text="{Binding CorruptedBackupCount}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{l10n:Tr SystemStatus}" />
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Opacity="0.6" Text="{l10n:Tr ScanResult}" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" />
                                <TextBlock Grid.Row="1" Opacity="0.6" Text="{l10n:Tr PrimaryProfile}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileName}" />
                                <TextBlock Grid.Row="2" Opacity="0.6" Text="{l10n:Tr BackupStatus}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SnapshotHistorySummary}" />
                                <TextBlock Grid.Row="3" Opacity="0.6" Text="{l10n:Tr BackupLocation}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Opacity="0.75"
                                           Text="{Binding SnapshotLibraryPath}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Margin="0,6,0,0" Padding="12" CornerRadius="7" Background="#12808080">
                                <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-title" Text="{l10n:Tr CommonActions}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{l10n:Tr Characters}" />
                                <TextBlock Grid.Row="1" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{l10n:Tr CharactersCardDescription}" />
                                <Button Grid.Row="2" HorizontalAlignment="Left"
                                        Command="{Binding ShowCharactersCommand}" Content="{l10n:Tr OpenCharacters}" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{l10n:Tr Backups}" />
                                <TextBlock Grid.Row="1" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{l10n:Tr BackupsCardDescription}" />
                                <Button Grid.Row="2" HorizontalAlignment="Left"
                                        Command="{Binding ShowBackupsCommand}" Content="{l10n:Tr OpenBackups}" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{l10n:Tr Migration}" />
                                <TextBlock Grid.Row="1" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{l10n:Tr MigrationCardDescription}" />
                                <Button Grid.Row="2" HorizontalAlignment="Left"
                                        Command="{Binding ShowMigrationCommand}" Content="{l10n:Tr StartMigration}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 角色管理 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsCharactersPage}">
                <StackPanel Margin="28" Spacing="14">
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="section-title" Text="{l10n:Tr DiscoveredCharacters}" />
                                <TextBlock Opacity="0.65" Text="{Binding Summary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ShowSettingsCommand}"
                                    Content="{l10n:Tr ManageProfiles}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="18,14">
                                    <Grid ColumnDefinitions="210,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="14" RowSpacing="6">
                                        <Grid Grid.RowSpan="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBox Text="{Binding Alias}" PlaceholderText="{l10n:Tr CharacterTag}" />
                                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,5"
                                                    Command="{Binding SaveAliasCommand}" Content="{l10n:Tr Save}" />
                                        </Grid>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock FontFamily="Cascadia Mono,Consolas" FontWeight="SemiBold"
                                                       Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Text="{Binding LastModified}" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="14">
                                            <TextBlock Opacity="0.65" Text="{Binding ProfileName}" />
                                            <TextBlock FontSize="12" Opacity="0.75" Text="{Binding FileSummary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Opacity="0.75"
                                                   Text="{Binding BackupStatus}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center"
                                                    Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding CreateSnapshotCommand}"
                                                    Content="{l10n:Tr CreateBackup}" />
                                            <Button Command="{Binding ManageBackupsCommand}"
                                                    Content="{l10n:Tr RestoreBackup}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 备份与恢复 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsBackupsPage}">
                <StackPanel Margin="28" Spacing="16">
                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{l10n:Tr BackupLocation}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.65"
                                       Text="{Binding SnapshotLibraryPath}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Command="{Binding SelectSnapshotLibraryCommand}"
                                    Content="{l10n:Tr ChangeLocation}" />
                        </Grid>
                    </Border>
                    <Grid Margin="0,6,0,0" ColumnDefinitions="*,280">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="section-title" Text="{l10n:Tr BackupHistory}" />
                            <TextBlock Opacity="0.65" Text="{Binding SnapshotHistorySummary}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding SnapshotFilter}"
                                 PlaceholderText="{l10n:Tr BackupFilterPlaceholder}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding BackupGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterBackupGroupViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="18,14">
                                    <Grid ColumnDefinitions="220,*,Auto" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="14" RowSpacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding CharacterName}" />
                                        <TextBlock Grid.Column="1" Opacity="0.7" Text="{Binding Status}"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                                                Command="{Binding OpenCommand}"
                                                Content="{l10n:Tr ManageBackups}" />
                                        <TextBlock Grid.Row="1" Opacity="0.6" Text="{Binding ProfileName}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 角色迁移 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsMigrationPage}">
                <StackPanel Margin="28" Spacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="section-title" Text="{l10n:Tr SelectMigrationCharacters}" />
                            <Grid ColumnDefinitions="*,50,*" ColumnSpacing="10">
                                <ComboBox ItemsSource="{Binding Characters}"
                                          SelectedItem="{Binding SelectedMigrationSource}"
                                          PlaceholderText="{l10n:Tr SelectSourceCharacter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Opacity="0.55" Text="{Binding ProfileName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="20" Text="→" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Characters}"
                                          SelectedItem="{Binding SelectedMigrationTarget}"
                                          PlaceholderText="{l10n:Tr SelectTargetCharacter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Opacity="0.55" Text="{Binding ProfileName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{l10n:Tr MigrationScope}" />
                            <ItemsControl ItemsSource="{Binding MigrationScopes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MigrationScopeOptionViewModel">
                                        <CheckBox Margin="0,0,22,6" IsChecked="{Binding IsSelected}"
                                                  Content="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="{l10n:Tr MigrationScopeDescription}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Classes="section-title" VerticalAlignment="Center"
                                           Text="{Binding MigrationPreviewTitle}" />
                                <Button Grid.Column="1" Command="{Binding PreviewMigrationCommand}"
                                        Content="{l10n:Tr GenerateMigrationPreview}" />
                                <Button Grid.Column="2" Command="{Binding ConfirmMigrationCommand}"
                                        IsEnabled="{Binding CanConfirmMigration}" Content="{l10n:Tr ConfirmMigration}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MigrationPreviewFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SnapshotFilePreviewViewModel">
                                        <Grid Margin="0,3" ColumnDefinitions="180,120,*">
                                            <TextBlock FontFamily="Cascadia Mono,Consolas" Text="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Opacity="0.65" Text="{Binding SnapshotSize}" />
                                            <TextBlock Grid.Column="2" Text="{Binding DifferenceText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 配置与存储 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsSettingsPage}">
                <StackPanel Margin="28" Spacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="section-title" Text="{l10n:Tr ProfileSource}" />
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="{l10n:Tr ProfileDescription}" />
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProfileRowViewModel">
                                        <Grid Margin="0,5" ColumnDefinitions="140,90,*,Auto">
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7"
                                                       Text="{Binding Region}" />
                                            <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                                       Opacity="0.65" Text="{Binding ConfigRoot}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="3" Command="{Binding RemoveCommand}" Content="{l10n:Tr Remove}"
                                                    IsVisible="{Binding CanRemove}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="180,140,*,Auto" ColumnSpacing="10">
                                <TextBox PlaceholderText="{l10n:Tr ProfileNamePlaceholder}" Text="{Binding NewProfileName}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RegionOptions}"
                                          SelectedItem="{Binding SelectedRegion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameRegionOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                           Text="{l10n:Tr ProfilePathHint}" />
                                <Button Grid.Column="3" Command="{Binding AddProfileCommand}"
                                        Content="{l10n:Tr SelectAndAddDirectory}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{l10n:Tr ApplicationUpdate}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersionText}" />
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding UpdateStatusText}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding CheckForUpdatesCommand}"
                                        Content="{l10n:Tr CheckForUpdates}" />
                                <Button Command="{Binding InstallUpdateCommand}"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        Content="{l10n:Tr DownloadAndInstallUpdate}" />
                                <ProgressBar Width="100" IsIndeterminate="True"
                                             IsVisible="{Binding IsUpdateBusy}" />
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       IsVisible="{Binding !IsAutomaticUpdateSupported}"
                                       Text="{l10n:Tr AutomaticUpdatePublishedOnly}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{l10n:Tr SoftwareSettingsBackup}" />
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="{l10n:Tr SoftwareSettingsDescription}" />
                            <TextBlock FontWeight="SemiBold" Text="{l10n:Tr SettingsBackupStatusTitle}" />
                            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                       Text="{Binding SettingsBackupStatusText}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding BackupSettingsCommand}"
                                        Content="{l10n:Tr BackupSoftwareSettings}" />
                                <Button Command="{Binding RestoreSettingsCommand}"
                                        IsEnabled="{Binding CanRestoreSettingsBackup}"
                                        Content="{l10n:Tr RestoreSoftwareSettings}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{l10n:Tr BackupStorage}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Opacity="0.65"
                                           Text="{Binding SnapshotLibraryPath}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{Binding SelectSnapshotLibraryCommand}"
                                        Content="{l10n:Tr SelectBackupLocation}" />
                            </Grid>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="{l10n:Tr BackupStorageDescription}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Padding="28,10" BorderBrush="#40808080"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" Opacity="0.65"
                       Text="{l10n:Tr PrivacyNotice}" />
        </Border>
    </Grid>
</Window>
