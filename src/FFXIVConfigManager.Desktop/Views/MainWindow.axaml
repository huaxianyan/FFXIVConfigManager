<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFXIVConfigManager.Desktop.ViewModels"
        x:Class="FFXIVConfigManager.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Icon="/Assets/app.ico"
        Title="FFXIV 角色配置管理器">

    <Window.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="Background" Value="#0A808080" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#16808080" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#285B8DEF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto">
        <Border Grid.RowSpan="2" Background="#0E808080"
                BorderBrush="#40808080" BorderThickness="0,0,1,0">
            <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Margin="8,10,8,22" Spacing="4">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="FFXIV 配置管理器" />
                    <TextBlock FontSize="12" Opacity="0.6" Text="安全备份与迁移" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Classes.nav="True" Classes.active="{Binding IsDashboardPage}"
                            Command="{Binding ShowDashboardCommand}" Content="概览" />
                    <Button Classes.nav="True" Classes.active="{Binding IsCharactersPage}"
                            Command="{Binding ShowCharactersCommand}" Content="角色管理" />
                    <Button Classes.nav="True" Classes.active="{Binding IsBackupsPage}"
                            Command="{Binding ShowBackupsCommand}" Content="备份与恢复" />
                    <Button Classes.nav="True" Classes.active="{Binding IsMigrationPage}"
                            Command="{Binding ShowMigrationCommand}" Content="角色迁移" />
                    <Button Classes.nav="True" Classes.active="{Binding IsSettingsPage}"
                            Command="{Binding ShowSettingsCommand}" Content="配置与存储" />
                </StackPanel>

                <Border Grid.Row="3" Classes="card" Padding="12">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="当前状态" />
                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                   MaxLines="4" Text="{Binding StatusMessage}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Padding="28,20" BorderBrush="#40808080" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
                        <TextBlock Opacity="0.65" Text="{Binding PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <ProgressBar Width="90" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                        <Button Command="{Binding RefreshCommand}" Content="重新扫描" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 概览 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsDashboardPage}">
                <StackPanel Margin="28" Spacing="20">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="配置源" />
                                <TextBlock Classes="stat-value" Text="{Binding Profiles.Count}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="已发现角色" />
                                <TextBlock Classes="stat-value" Text="{Binding Characters.Count}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="有效备份" />
                                <TextBlock Classes="stat-value" Text="{Binding HealthyBackupCount}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Opacity="0.65" Text="损坏备份" />
                                <TextBlock Classes="stat-value" Text="{Binding CorruptedBackupCount}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="系统状态" />
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Opacity="0.6" Text="扫描结果" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" />
                                <TextBlock Grid.Row="1" Opacity="0.6" Text="主要配置源" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileName}" />
                                <TextBlock Grid.Row="2" Opacity="0.6" Text="备份状态" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SnapshotHistorySummary}" />
                                <TextBlock Grid.Row="3" Opacity="0.6" Text="备份位置" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Opacity="0.75"
                                           Text="{Binding SnapshotLibraryPath}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Margin="0,6,0,0" Padding="12" CornerRadius="7" Background="#12808080">
                                <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-title" Text="常用功能" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="角色管理" />
                                <TextBlock Grid.Row="1" Opacity="0.65" TextWrapping="Wrap"
                                           Text="查看角色配置完整度、设置标记并创建备份。" />
                                <Button Grid.Row="2" HorizontalAlignment="Left"
                                        Command="{Binding ShowCharactersCommand}" Content="进入角色管理" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="备份与恢复" />
                                <TextBlock Grid.Row="1" Opacity="0.65" TextWrapping="Wrap"
                                           Text="查看备份历史、完整性状态和恢复预览。" />
                                <Button Grid.Row="2" HorizontalAlignment="Left"
                                        Command="{Binding ShowBackupsCommand}" Content="查看备份" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="角色迁移" />
                                <TextBlock Grid.Row="1" Opacity="0.65" TextWrapping="Wrap"
                                           Text="选择源角色和目标角色，预览后安全迁移。" />
                                <Button Grid.Row="2" HorizontalAlignment="Left"
                                        Command="{Binding ShowMigrationCommand}" Content="开始迁移" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 角色管理 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsCharactersPage}">
                <StackPanel Margin="28" Spacing="14">
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="section-title" Text="已发现角色" />
                                <TextBlock Opacity="0.65" Text="{Binding Summary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ShowSettingsCommand}"
                                    Content="管理配置源" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="18,14">
                                    <Grid ColumnDefinitions="210,*,170,100" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="14" RowSpacing="8">
                                        <Grid Grid.RowSpan="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBox Text="{Binding Alias}" PlaceholderText="角色标记" />
                                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,5"
                                                    Command="{Binding SaveAliasCommand}" Content="保存" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Consolas"
                                                   FontWeight="SemiBold" Text="{Binding FolderName}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Text="{Binding LastModified}" />
                                        <Button Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center"
                                                Command="{Binding CreateSnapshotCommand}" Content="创建备份" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="14">
                                            <TextBlock Opacity="0.65" Text="{Binding ProfileName}" />
                                            <TextBlock FontSize="12" Opacity="0.75" Text="{Binding FileSummary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 备份与恢复 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsBackupsPage}">
                <StackPanel Margin="28" Spacing="16">
                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="备份位置" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.65"
                                       Text="{Binding SnapshotLibraryPath}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Command="{Binding SelectSnapshotLibraryCommand}"
                                    Content="更改位置" />
                        </Grid>
                    </Border>
                    <Grid Margin="0,6,0,0" ColumnDefinitions="*,280">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="section-title" Text="备份历史" />
                            <TextBlock Opacity="0.65" Text="{Binding SnapshotHistorySummary}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding SnapshotFilter}"
                                 PlaceholderText="按角色、配置源或状态筛选" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Snapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnapshotRowViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="18,12"
                                        ToolTip.Tip="{Binding ErrorSummary}">
                                    <Grid ColumnDefinitions="190,*,170,Auto" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="14" RowSpacing="6">
                                        <StackPanel Grid.RowSpan="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding CharacterName}" />
                                            <TextBlock FontSize="11" Opacity="0.55" Text="{Binding CharacterFolder}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Opacity="0.7" Text="{Binding FileSummary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" />
                                        <StackPanel Grid.Column="3" Grid.RowSpan="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Spacing="6">
                                            <Button Command="{Binding PreviewCommand}" Content="预览" />
                                            <Button Command="{Binding DeleteCommand}"
                                                    Content="{Binding DeleteButtonText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="14">
                                            <TextBlock Opacity="0.65" Text="{Binding ProfileName}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding IntegrityText}" />
                                            <TextBlock FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                                       Text="{Binding TypeText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="card" Margin="0,2,0,12">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section-title" Text="{Binding SnapshotPreviewTitle}" />
                                <Button Grid.Column="1" Command="{Binding ConfirmRestoreCommand}"
                                        IsEnabled="{Binding CanRestorePreview}"
                                        Content="确认恢复到原角色" />
                            </Grid>
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="恢复前会自动创建目标角色恢复点。恢复采用暂存、逐文件校验、事务日志和失败回滚；不会因为 FFXIV 正在运行而禁止操作。" />
                            <ItemsControl ItemsSource="{Binding SnapshotPreviewFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SnapshotFilePreviewViewModel">
                                        <Grid Margin="0,3" ColumnDefinitions="180,120,*">
                                            <TextBlock FontFamily="Cascadia Mono,Consolas" Text="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Opacity="0.65" Text="{Binding SnapshotSize}" />
                                            <TextBlock Grid.Column="2" Text="{Binding DifferenceText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 角色迁移 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsMigrationPage}">
                <StackPanel Margin="28" Spacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="section-title" Text="选择迁移角色" />
                            <Grid ColumnDefinitions="*,50,*" ColumnSpacing="10">
                                <ComboBox ItemsSource="{Binding Characters}"
                                          SelectedItem="{Binding SelectedMigrationSource}"
                                          PlaceholderText="选择源角色">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Opacity="0.55" Text="{Binding ProfileName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="20" Text="→" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Characters}"
                                          SelectedItem="{Binding SelectedMigrationTarget}"
                                          PlaceholderText="选择目标角色">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Opacity="0.55" Text="{Binding ProfileName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="迁移范围" />
                            <ItemsControl ItemsSource="{Binding MigrationScopes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MigrationScopeOptionViewModel">
                                        <CheckBox Margin="0,0,22,6" IsChecked="{Binding IsSelected}"
                                                  Content="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="默认范围包含 UISAVE.DAT（界面状态与场地标点），但不包含隐私、缓存和物品排序。高级的“全部 14 个已知文件”模式会覆盖 ACQ.DAT、ITEMFDR.DAT、ITEMODR.DAT 等文件，仅建议确认确有需要时使用。迁移前仍会创建目标恢复点。" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Classes="section-title" VerticalAlignment="Center"
                                           Text="{Binding MigrationPreviewTitle}" />
                                <Button Grid.Column="1" Command="{Binding PreviewMigrationCommand}"
                                        Content="生成迁移预览" />
                                <Button Grid.Column="2" Command="{Binding ConfirmMigrationCommand}"
                                        IsEnabled="{Binding CanConfirmMigration}" Content="确认迁移" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MigrationPreviewFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SnapshotFilePreviewViewModel">
                                        <Grid Margin="0,3" ColumnDefinitions="180,120,*">
                                            <TextBlock FontFamily="Cascadia Mono,Consolas" Text="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Opacity="0.65" Text="{Binding SnapshotSize}" />
                                            <TextBlock Grid.Column="2" Text="{Binding DifferenceText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 配置与存储 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsSettingsPage}">
                <StackPanel Margin="28" Spacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="section-title" Text="配置源" />
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="配置源是包含 FFXIV_CHR… 角色目录的游戏配置根目录。移除配置源不会删除磁盘文件。" />
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProfileRowViewModel">
                                        <Grid Margin="0,5" ColumnDefinitions="140,90,*,Auto">
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7"
                                                       Text="{Binding Region}" />
                                            <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                                       Opacity="0.65" Text="{Binding ConfigRoot}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="3" Command="{Binding RemoveCommand}" Content="移除"
                                                    IsVisible="{Binding CanRemove}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="180,140,*,Auto" ColumnSpacing="10">
                                <TextBox PlaceholderText="配置源名称" Text="{Binding NewProfileName}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RegionOptions}"
                                          SelectedItem="{Binding SelectedRegion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameRegionOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                           Text="选择包含角色文件夹的配置根目录" />
                                <Button Grid.Column="3" Command="{Binding AddProfileCommand}"
                                        Content="选择目录并添加" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="软件设置备份" />
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="导出角色标记及相关软件设置。换设备后导入会按角色目录 ID 重新匹配标记，并保留新设备自己的配置源和备份位置；游戏 DAT 文件仍由角色备份单独管理。" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding ExportSettingsCommand}" Content="导出软件设置" />
                                <Button Command="{Binding ImportSettingsCommand}" Content="导入软件设置" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="备份存储" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Opacity="0.65"
                                           Text="{Binding SnapshotLibraryPath}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{Binding SelectSnapshotLibraryCommand}"
                                        Content="选择备份位置" />
                            </Grid>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="备份采用开放 ZIP 格式并包含完整性清单。历史记录可直接从备份文件重建。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Padding="28,10" BorderBrush="#40808080"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" Opacity="0.65"
                       Text="只读取配置元数据，不读取聊天日志或解析 DAT 内容。所有覆盖操作均提供预览和恢复路径。" />
        </Border>
    </Grid>
</Window>
