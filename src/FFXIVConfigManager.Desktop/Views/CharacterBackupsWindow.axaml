<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFXIVConfigManager.Desktop.ViewModels"
        xmlns:l10n="using:FFXIVConfigManager.Desktop.Localization"
        x:Class="FFXIVConfigManager.Desktop.Views.CharacterBackupsWindow"
        x:DataType="vm:CharacterBackupsViewModel"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Opacity="0.65" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <RadioButton GroupName="BackupLayer"
                         IsChecked="{Binding !IsShowingAutomatic}"
                         Content="{Binding ManualTabTitle}" />
            <RadioButton GroupName="BackupLayer"
                         IsChecked="{Binding IsShowingAutomatic}"
                         Content="{Binding AutomaticTabTitle}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="340,*" ColumnSpacing="16">
            <Border Padding="8" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <ListBox ItemsSource="{Binding VisibleBackups}"
                         SelectedItem="{Binding SelectedBackup}"
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupOptionViewModel">
                            <TextBlock Margin="4,6" Text="{Binding DisplayName}"
                                       ToolTip.Tip="{Binding Details}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock VerticalAlignment="Center" Text="{l10n:Tr RestoreTargetProfile}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding TargetProfiles}"
                              SelectedItem="{Binding SelectedTargetProfile}"
                              IsEnabled="{Binding CanSelectTargetProfile}"
                              PlaceholderText="{l10n:Tr SelectRestoreProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameProfileOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Profile.ConfigRoot}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding PreviewCommand}"
                            Content="{l10n:Tr PreviewSelectedBackup}" />
                    <Button Command="{Binding RestoreCommand}"
                            Content="{l10n:Tr RestoreSelectedBackup}" />
                    <Button Command="{Binding DeleteCommand}"
                            IsVisible="{Binding IsDeleteAvailable}"
                            Content="{Binding DeleteButtonText}" />
                </StackPanel>

                <TextBlock Grid.Row="2" IsVisible="{Binding SelectedBackupDetails.Length}"
                           Opacity="0.7" TextWrapping="Wrap"
                           Text="{Binding SelectedBackupDetails}" />

                <Border Grid.Row="3" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PreviewFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SnapshotFilePreviewViewModel">
                                    <Grid Margin="0,5" ColumnDefinitions="200,120,*">
                                        <TextBlock FontFamily="Cascadia Mono,Consolas" Text="{Binding FileName}" />
                                        <TextBlock Grid.Column="1" Opacity="0.65" Text="{Binding SnapshotSize}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DifferenceText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
