<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFXIVConfigManager.Desktop.ViewModels"
             xmlns:l10n="using:FFXIVConfigManager.Desktop.Localization"
             x:Class="FFXIVConfigManager.Desktop.Views.AppearanceBackupsView"
             x:DataType="vm:AppearanceBackupsViewModel">
    <Grid Margin="28" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <TextBlock VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap"
                       Text="{Binding StatusMessage}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ProgressBar Width="90" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <Button Command="{Binding RefreshCommand}" Content="{l10n:Tr RefreshAppearances}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,210,*" ColumnSpacing="14">
            <!-- 左栏的数据源类型固定为游戏配置源。 -->
            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding LeftPanelTitle}" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedLeftProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppearanceProfileOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ListBox Grid.Row="2" ItemsSource="{Binding LeftItems}"
                             SelectedItem="{Binding SelectedLeftItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppearanceListItemViewModel">
                                <Grid Margin="4,7" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Grid.Row="1" Opacity="0.74" Text="{Binding Summary}"
                                               TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Grid.Row="2" FontSize="11" Opacity="0.58"
                                               Text="{Binding SecondaryText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <Button Width="58" Height="42" HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            FontSize="24" Command="{Binding SwapDirectionCommand}"
                            Content="{Binding DirectionSymbol}"
                            ToolTip.Tip="{l10n:Tr SwapAppearanceDirection}" />
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding ExecuteOperationCommand}"
                            Content="{Binding OperationName}" />
                    <TextBlock FontSize="11" Opacity="0.6" TextAlignment="Center"
                               TextWrapping="Wrap" Text="{l10n:Tr AppearanceOverwriteHint}" />
                </StackPanel>
            </Border>

            <!-- 右栏可以在备份区和任意游戏配置源之间切换。 -->
            <Border Grid.Column="2" Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding RightPanelTitle}" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding RightSources}"
                              SelectedItem="{Binding SelectedRightSource}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppearanceRightSourceOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8"
                          IsVisible="{Binding IsRightBackupArea}">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding RaceFilters}"
                                      SelectedItem="{Binding SelectedRaceFilter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppearanceRaceFilterViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding GenderFilters}"
                                      SelectedItem="{Binding SelectedGenderFilter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppearanceGenderFilterViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Command="{Binding DeleteBackupCommand}"
                                    Content="{Binding DeleteButtonText}" />
                        </Grid>
                        <TextBox Grid.Row="1" Text="{Binding SearchText}"
                                 PlaceholderText="{l10n:Tr SearchAppearanceComment}" />
                    </Grid>
                    <ListBox Grid.Row="3" ItemsSource="{Binding RightItems}"
                             SelectedItem="{Binding SelectedRightItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppearanceListItemViewModel">
                                <Grid Margin="4,7" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Grid.Row="1" Opacity="0.74" Text="{Binding Summary}"
                                               TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Grid.Row="2" FontSize="11" Opacity="0.58"
                                               Text="{Binding SecondaryText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="11" CornerRadius="8" Background="#105B8DEF">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="{l10n:Tr AppearanceOperationRules}" />
        </Border>
    </Grid>
</UserControl>
